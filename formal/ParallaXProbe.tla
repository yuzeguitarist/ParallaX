\* Generated by formal/plx_formal.py from the ParallaXProbe tables.
\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* Client probe status (Verified, Unreachable, Failed) and the server PX1P gate: matching offer, held conn, or abort.
\*
\* Safety claims (states and steps that must be unreachable):
\*   VerifiedOnlyIfAuthentic: the client classifier reports Verified only for a reply that passed the magic, length, and MAC chain
\*   BadMacIsFailed: a reply with a bad exporter MAC is Failed, not Verified and not Unreachable
\*   TimeoutIsUnreachable: a Happy-Eyeballs timeout is Unreachable
\*   LostConnectionIsUnreachable: a lost connection is Unreachable, not a failed authentication
\*   ShortReplyIsFailed: a short or truncated reply is Failed
\*   LongBodyIsFailed: a body that fails the length conjunct is Failed
\*   SetupIsFailed: a bind or setup failure is Failed, the status the client returns for that path
\*   RetainOnlyMatchingAck: QUIC is retained only for an AEAD-opened PX1P ack with a matching offer_id, status Verified, and the conn still held
\*   VerifiedWithoutConnHardFails: a matching Verified ack with no probed connection is a hard failure, not a silent TCP fallback
\*   MismatchStaysOnTcp: any decoded PX1P status whose offer_id does not match stays on TCP even if the conn is held
\*   VerifiedStayIsARejectedAck: staying on TCP after a Verified status is a mismatched offer_id or a decode failure
\*   Px1pTimeoutAborts: a PX1P read timeout aborts and does not stay on TCP
\*   Px1pEofAborts: a PX1P read EOF aborts and does not stay on TCP

---- MODULE ParallaXProbe ----
EXTENDS Integers

VARIABLES obs, have, outcome, status, offer, read, decision

vars == << obs, have, outcome, status, offer, read, decision >>

Init ==
  \/ (obs = "timeout" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "timeout" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "lost" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "lost" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "setup" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "setup" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "short" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "short" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "bad_magic" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "bad_magic" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "bad_mac" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "bad_mac" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "long" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "long" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "ok" /\ have = FALSE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")
  \/ (obs = "ok" /\ have = TRUE /\ outcome = "pending" /\ status = "none" /\ offer = "pending" /\ read = "pending" /\ decision = "pending")

ToUnreachableTimeout ==
  /\ (obs = "timeout" /\ outcome = "pending")
  /\ outcome' = "unreachable"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToUnreachableLost ==
  /\ (obs = "lost" /\ outcome = "pending")
  /\ outcome' = "unreachable"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToFailSetup ==
  /\ (obs = "setup" /\ outcome = "pending")
  /\ outcome' = "failed"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToFailShort ==
  /\ (obs = "short" /\ outcome = "pending")
  /\ outcome' = "failed"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToFailMagic ==
  /\ (obs = "bad_magic" /\ outcome = "pending")
  /\ outcome' = "failed"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToFailMac ==
  /\ (obs = "bad_mac" /\ outcome = "pending")
  /\ outcome' = "failed"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToFailLong ==
  /\ (obs = "long" /\ outcome = "pending")
  /\ outcome' = "failed"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

ToVerified ==
  /\ (obs = "ok" /\ outcome = "pending")
  /\ outcome' = "verified"
  /\ UNCHANGED << obs, have, status, offer, read, decision >>

StatUnreachable ==
  /\ (outcome = "unreachable" /\ status = "none")
  /\ status' = "unreachable"
  /\ UNCHANGED << obs, have, outcome, offer, read, decision >>

StatFailed ==
  /\ (outcome = "failed" /\ status = "none")
  /\ status' = "failed"
  /\ UNCHANGED << obs, have, outcome, offer, read, decision >>

StatVerified ==
  /\ (outcome = "verified" /\ status = "none")
  /\ status' = "verified"
  /\ UNCHANGED << obs, have, outcome, offer, read, decision >>

Px1pTimeout ==
  /\ (decision = "pending" /\ read = "pending")
  /\ read' = "timeout"
  /\ decision' = "abort"
  /\ UNCHANGED << obs, have, outcome, status, offer >>

Px1pEof ==
  /\ (decision = "pending" /\ read = "pending")
  /\ read' = "eof"
  /\ decision' = "abort"
  /\ UNCHANGED << obs, have, outcome, status, offer >>

DecodeFail ==
  /\ (decision = "pending" /\ read = "pending")
  /\ read' = "decode"
  /\ decision' = "stay"
  /\ UNCHANGED << obs, have, outcome, status, offer >>

RejectAck ==
  /\ (status \in {"verified", "unreachable", "failed"} /\ decision = "pending" /\ read = "pending")
  /\ offer' = "mismatch"
  /\ read' = "ok"
  /\ decision' = "stay"
  /\ UNCHANGED << obs, have, outcome, status >>

Retain ==
  /\ (status = "verified" /\ have /\ decision = "pending" /\ read = "pending")
  /\ offer' = "match"
  /\ read' = "ok"
  /\ decision' = "retain"
  /\ UNCHANGED << obs, have, outcome, status >>

HardFail ==
  /\ (status = "verified" /\ ~have /\ decision = "pending" /\ read = "pending")
  /\ offer' = "match"
  /\ read' = "ok"
  /\ decision' = "hard_fail"
  /\ UNCHANGED << obs, have, outcome, status >>

StayUnreachable ==
  /\ (status = "unreachable" /\ decision = "pending" /\ read = "pending")
  /\ offer' = "match"
  /\ read' = "ok"
  /\ decision' = "stay"
  /\ UNCHANGED << obs, have, outcome, status >>

StayFailed ==
  /\ (status = "failed" /\ decision = "pending" /\ read = "pending")
  /\ offer' = "match"
  /\ read' = "ok"
  /\ decision' = "stay"
  /\ UNCHANGED << obs, have, outcome, status >>

Next ==
  \/ ToUnreachableTimeout
  \/ ToUnreachableLost
  \/ ToFailSetup
  \/ ToFailShort
  \/ ToFailMagic
  \/ ToFailMac
  \/ ToFailLong
  \/ ToVerified
  \/ StatUnreachable
  \/ StatFailed
  \/ StatVerified
  \/ Px1pTimeout
  \/ Px1pEof
  \/ DecodeFail
  \/ RejectAck
  \/ Retain
  \/ HardFail
  \/ StayUnreachable
  \/ StayFailed

Spec == Init /\ [][Next]_vars

\* the client classifier reports Verified only for a reply that passed the magic, length, and MAC chain
VerifiedOnlyIfAuthentic ==
  outcome = "verified" => obs = "ok"

\* a reply with a bad exporter MAC is Failed, not Verified and not Unreachable
BadMacIsFailed ==
  obs = "bad_mac" /\ outcome # "pending" => outcome = "failed"

\* a Happy-Eyeballs timeout is Unreachable
TimeoutIsUnreachable ==
  obs = "timeout" /\ outcome # "pending" => outcome = "unreachable"

\* a lost connection is Unreachable, not a failed authentication
LostConnectionIsUnreachable ==
  obs = "lost" /\ outcome # "pending" => outcome = "unreachable"

\* a short or truncated reply is Failed
ShortReplyIsFailed ==
  obs = "short" /\ outcome # "pending" => outcome = "failed"

\* a body that fails the length conjunct is Failed
LongBodyIsFailed ==
  obs = "long" /\ outcome # "pending" => outcome = "failed"

\* a bind or setup failure is Failed, the status the client returns for that path
SetupIsFailed ==
  obs = "setup" /\ outcome # "pending" => outcome = "failed"

\* QUIC is retained only for an AEAD-opened PX1P ack with a matching offer_id, status Verified, and the conn still held
RetainOnlyMatchingAck ==
  decision = "retain" => (status = "verified" /\ offer = "match" /\ have /\ read = "ok")

\* a matching Verified ack with no probed connection is a hard failure, not a silent TCP fallback
VerifiedWithoutConnHardFails ==
  decision = "hard_fail" => (status = "verified" /\ offer = "match" /\ read = "ok" /\ ~have)

\* any decoded PX1P status whose offer_id does not match stays on TCP even if the conn is held
MismatchStaysOnTcp ==
  offer = "mismatch" => (decision = "stay" /\ read = "ok")

\* staying on TCP after a Verified status is a mismatched offer_id or a decode failure
VerifiedStayIsARejectedAck ==
  decision = "stay" /\ status = "verified" => (offer = "mismatch" \/ read = "decode")

\* a PX1P read timeout aborts and does not stay on TCP
Px1pTimeoutAborts ==
  read = "timeout" => decision = "abort"

\* a PX1P read EOF aborts and does not stay on TCP
Px1pEofAborts ==
  read = "eof" => decision = "abort"

