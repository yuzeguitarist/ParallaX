  /\ phase' = "failed"
  /\ reason' = "eof"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityReadIoError ==
  /\ (phase = "reading")
  /\ phase' = "failed"
  /\ reason' = "io"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityAuthFails ==
  /\ (phase = "auth")
  /\ phase' = "failed"
  /\ reason' = "aead"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityAuthOk ==
  /\ (phase = "auth")
  /\ phase' = "decode"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityDecodeReject ==
  /\ (phase = "decode" /\ (incoming_total = 0 \/ incoming_len = 0 \/ incoming_total < incoming_end))
  /\ phase' = "failed"
  /\ reason' = "decode"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityDecodeOk ==
  /\ (phase = "decode" /\ incoming_total # 0 /\ incoming_len # 0 /\ ~(incoming_total < incoming_end))
  /\ phase' = "cap"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityCapReject ==
  /\ (phase = "cap" /\ incoming_total = 4)
  /\ phase' = "failed"
  /\ reason' = "capacity"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityCapOk ==
  /\ (phase = "cap" /\ incoming_total < 4)
  /\ phase' = "total"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityLatchFirstTotal ==
  /\ (phase = "total" /\ total = 0)
  /\ phase' = "offset"
  /\ total' = incoming_total
  /\ UNCHANGED << cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityCheckTotal ==
  /\ (phase = "total" /\ total # 0 /\ incoming_total = total)
  /\ phase' = "offset"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityChangedTotal ==
  /\ (phase = "total" /\ total # 0 /\ incoming_total # total)
  /\ phase' = "failed"
  /\ reason' = "changed_total"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityWrongOffset ==
  /\ (phase = "offset" /\ incoming_offset # cursor)
  /\ phase' = "failed"
  /\ reason' = "offset"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityAppend ==
  /\ (phase = "offset" /\ incoming_offset = cursor)
  /\ phase' = "completion"
  /\ cursor' = incoming_end
  /\ before_cursor' = cursor
  /\ UNCHANGED << total, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityPartial ==
  /\ (phase = "completion" /\ cursor < total)
  /\ phase' = "reading"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityAssembled ==
  /\ (phase = "completion" /\ cursor = total)
  /\ phase' = "assembled"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent, reason >>

IdentityMissingBinding ==
  /\ (phase = "assembled" /\ ~binding)
  /\ phase' = "failed"
  /\ reason' = "binding"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityBadSignature ==
  /\ (phase = "assembled" /\ binding)
  /\ phase' = "failed"
  /\ reason' = "signature"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

IdentityVerifyOk ==
  /\ (phase = "assembled" /\ binding)
  /\ phase' = "verified"
  /\ verified' = TRUE
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, connect_sent, reason >>

IdentityThenConnect ==
  /\ (phase = "verified")
  /\ phase' = "connect"
  /\ connect_sent' = TRUE
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, reason >>

IdentityEstablishmentTimeout ==
  /\ (phase \in {"reading", "auth", "decode", "cap", "total", "offset", "completion", "assembled", "verified"})
  /\ phase' = "failed"
  /\ reason' = "deadline"
  /\ UNCHANGED << total, cursor, before_cursor, incoming_total, incoming_offset, incoming_len, incoming_end, binding, verified, connect_sent >>

