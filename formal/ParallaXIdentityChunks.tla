Spec == Init /\ [][Next]_vars

\* no accepted metadata can grow the caller buffer beyond its bounded capacity
IdentityBufferNeverExceedsCap ==
  cursor \in {0, 1, 2, 3} /\ total \in {0, 1, 2, 3} /\ ~(total < cursor)

\* append follows a matching total, exact offset, positive length, and in-range end
IdentityAppendRequiresValidatedMetadata ==
  phase = "completion" => (total = incoming_total /\ incoming_offset = before_cursor /\ cursor = incoming_end /\ incoming_len # 0 /\ incoming_offset < cursor /\ ~(total < cursor))

\* partial accumulation cannot be returned or verified
IdentityPartialCannotVerify ==
  phase \in {"assembled", "verified", "connect"} => (total # 0 /\ cursor = total)

\* verification success requires the full payload and the PQ identity binding
IdentityVerificationNeedsWholeBoundPayload ==
  verified => (binding /\ total # 0 /\ cursor = total)

\* EOF, AEAD, framing, signature, or deadline failure cannot send CONNECT
IdentityFailureBlocksConnect ==
  phase = "failed" => ~connect_sent

\* CONNECT follows complete reassembly and successful identity verification
IdentityConnectWaitsForVerification ==
  connect_sent => (phase = "connect" /\ verified /\ binding /\ cursor = total /\ total # 0)

