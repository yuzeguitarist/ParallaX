\* Generated by formal/plx_formal.py from the ParallaXKeys tables.
\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* Client and server write_handshake key-install order, including optional 0-RTT.
\*
\* Safety claims (states and steps that must be unreachable):
\*   ClientZeroRttOnlyIfOffered: client 0-RTT keys exist only after an offered ticket, and the zrtt phase has installed them
\*   ServerZeroRttOnlyIfAccepted: server 0-RTT keys exist only after early data was accepted, and that phase has installed them
\*   AcceptImpliesOffer: the server does not accept early data the client did not offer
\*   ClientHandshakeKeysBeforeOneRtt: client 1-RTT keys are installed only after Handshake keys, and only in the app phase
\*   ServerHandshakeKeysBeforeOneRtt: server 1-RTT keys are installed only after Handshake keys
\*   OfferedZeroRttBeforeHandshakeKeys: an offered ticket installs client 0-RTT keys before Handshake keys
\*   AcceptedZeroRttBeforeServerHello: accepted early data installs server 0-RTT keys before ServerHello is emitted
\*   FullHandshakeSkipsZeroRtt: a handshake that offered no ticket installs no 0-RTT keys on either side
\*   TicketOnlyAfterServerOneRtt: the NewSessionTicket phase is after server 1-RTT keys
\*   NoStekEmitsNoTicket: a server with no STEK reaches 1-RTT and emits no NewSessionTicket
\*   NoKeysBeforeClientHello: the client installs nothing in the initial phase

---- MODULE ParallaXKeys ----
EXTENDS Integers

VARIABLES offer, accept, c, s, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek

vars == << offer, accept, c, s, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

Init ==
  \/ (offer = FALSE /\ accept = FALSE /\ c = "start" /\ s = "start" /\ c_zrtt = FALSE /\ s_zrtt = FALSE /\ c_hs = FALSE /\ s_hs = FALSE /\ c_1rtt = FALSE /\ s_1rtt = FALSE /\ stek = TRUE)
  \/ (offer = TRUE /\ accept = FALSE /\ c = "start" /\ s = "start" /\ c_zrtt = FALSE /\ s_zrtt = FALSE /\ c_hs = FALSE /\ s_hs = FALSE /\ c_1rtt = FALSE /\ s_1rtt = FALSE /\ stek = TRUE)
  \/ (offer = FALSE /\ accept = FALSE /\ c = "start" /\ s = "start" /\ c_zrtt = FALSE /\ s_zrtt = FALSE /\ c_hs = FALSE /\ s_hs = FALSE /\ c_1rtt = FALSE /\ s_1rtt = FALSE /\ stek = FALSE)
  \/ (offer = TRUE /\ accept = FALSE /\ c = "start" /\ s = "start" /\ c_zrtt = FALSE /\ s_zrtt = FALSE /\ c_hs = FALSE /\ s_hs = FALSE /\ c_1rtt = FALSE /\ s_1rtt = FALSE /\ stek = FALSE)

AcceptEarly ==
  /\ (s = "start" /\ offer /\ ~accept)
  /\ accept' = TRUE
  /\ UNCHANGED << offer, c, s, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

EmitCh ==
  /\ (c = "start")
  /\ c' = "ch"
  /\ UNCHANGED << offer, accept, s, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

EmitCZrtt ==
  /\ (c = "ch" /\ offer /\ ~c_zrtt)
  /\ c' = "zrtt"
  /\ c_zrtt' = TRUE
  /\ UNCHANGED << offer, accept, s, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

EmitCHsNoZrtt ==
  /\ (c = "ch" /\ ~offer)
  /\ c' = "hs"
  /\ c_hs' = TRUE
  /\ UNCHANGED << offer, accept, s, c_zrtt, s_zrtt, s_hs, c_1rtt, s_1rtt, stek >>

EmitCHsAfterZrtt ==
  /\ (c = "zrtt")
  /\ c' = "hs"
  /\ c_hs' = TRUE
  /\ UNCHANGED << offer, accept, s, c_zrtt, s_zrtt, s_hs, c_1rtt, s_1rtt, stek >>

EmitCApp ==
  /\ (c = "hs")
  /\ c' = "app"
  /\ c_1rtt' = TRUE
  /\ UNCHANGED << offer, accept, s, c_zrtt, s_zrtt, c_hs, s_hs, s_1rtt, stek >>

EmitSZrtt ==
  /\ (s = "start" /\ accept /\ ~s_zrtt)
  /\ s' = "zrtt"
  /\ s_zrtt' = TRUE
  /\ UNCHANGED << offer, accept, c, c_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

EmitSShNoZrtt ==
  /\ (s = "start" /\ ~accept)
  /\ s' = "sh"
  /\ UNCHANGED << offer, accept, c, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

EmitSShAfterZrtt ==
  /\ (s = "zrtt")
  /\ s' = "sh"
  /\ UNCHANGED << offer, accept, c, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

EmitSHs ==
  /\ (s = "sh")
  /\ s' = "hs"
  /\ s_hs' = TRUE
  /\ UNCHANGED << offer, accept, c, c_zrtt, s_zrtt, c_hs, c_1rtt, s_1rtt, stek >>

EmitSApp ==
  /\ (s = "hs")
  /\ s' = "app"
  /\ s_1rtt' = TRUE
  /\ UNCHANGED << offer, accept, c, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, stek >>

EmitNst ==
  /\ (s = "app" /\ stek)
  /\ s' = "nst"
  /\ UNCHANGED << offer, accept, c, c_zrtt, s_zrtt, c_hs, s_hs, c_1rtt, s_1rtt, stek >>

Next ==
  \/ AcceptEarly
  \/ EmitCh
  \/ EmitCZrtt
  \/ EmitCHsNoZrtt
  \/ EmitCHsAfterZrtt
  \/ EmitCApp
  \/ EmitSZrtt
  \/ EmitSShNoZrtt
  \/ EmitSShAfterZrtt
  \/ EmitSHs
  \/ EmitSApp
  \/ EmitNst

Spec == Init /\ [][Next]_vars

\* client 0-RTT keys exist only after an offered ticket, and the zrtt phase has installed them
ClientZeroRttOnlyIfOffered ==
  (c_zrtt => offer) /\ (c = "zrtt" => c_zrtt)

\* server 0-RTT keys exist only after early data was accepted, and that phase has installed them
ServerZeroRttOnlyIfAccepted ==
  (s_zrtt => accept) /\ (s = "zrtt" => s_zrtt)

\* the server does not accept early data the client did not offer
AcceptImpliesOffer ==
  accept => offer

\* client 1-RTT keys are installed only after Handshake keys, and only in the app phase
ClientHandshakeKeysBeforeOneRtt ==
  c_1rtt => (c_hs /\ c = "app")

\* server 1-RTT keys are installed only after Handshake keys
ServerHandshakeKeysBeforeOneRtt ==
  s_1rtt => s_hs

\* an offered ticket installs client 0-RTT keys before Handshake keys
OfferedZeroRttBeforeHandshakeKeys ==
  (c = "hs" \/ c = "app") /\ offer => c_zrtt

\* accepted early data installs server 0-RTT keys before ServerHello is emitted
AcceptedZeroRttBeforeServerHello ==
  (s = "sh" \/ s = "hs" \/ s = "app" \/ s = "nst") /\ accept => s_zrtt

\* a handshake that offered no ticket installs no 0-RTT keys on either side
FullHandshakeSkipsZeroRtt ==
  ~offer => (~c_zrtt /\ ~s_zrtt)

\* the NewSessionTicket phase is after server 1-RTT keys
TicketOnlyAfterServerOneRtt ==
  s = "nst" => (s_1rtt /\ s_hs)

\* a server with no STEK reaches 1-RTT and emits no NewSessionTicket
NoStekEmitsNoTicket ==
  ~stek => s # "nst"

\* the client installs nothing in the initial phase
NoKeysBeforeClientHello ==
  c = "start" => (~c_zrtt /\ ~c_hs /\ ~c_1rtt)

