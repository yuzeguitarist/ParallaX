\* Generated by formal/plx_formal.py from the ParallaXPacket tables.
\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* First-byte header class to QUIC packet space. Retry and a clear fixed bit are not spaces.
\*
\* Safety claims (states and steps that must be unreachable):
\*   ShortHeaderIsOneRtt: a short header is the 1-RTT space and nothing else is
\*   LongTypesMatchTheirSpace: Initial, 0-RTT, and Handshake map to those spaces
\*   RetryIsNotASpace: Retry is not decrypted as a packet-number space
\*   ClearFixedBitIsNotASpace: a clear fixed bit is not a packet space
\*   EmptyIsNotASpace: an empty datagram is not a packet space
\*   ZeroRttIsItsOwnSpace: 0-RTT is classified on its own, not as 1-RTT and not as Initial
\*   NoneOnlyForRejects: the no-space result is only empty, a clear fixed bit, or Retry

---- MODULE ParallaXPacket ----
EXTENDS Integers

VARIABLES form, space

vars == << form, space >>

Init ==
  \/ (form = "empty" /\ space = "pending")
  \/ (form = "bad_fixed" /\ space = "pending")
  \/ (form = "short" /\ space = "pending")
  \/ (form = "initial" /\ space = "pending")
  \/ (form = "zerortt" /\ space = "pending")
  \/ (form = "handshake" /\ space = "pending")
  \/ (form = "retry" /\ space = "pending")

MapEmpty ==
  /\ (form = "empty" /\ space = "pending")
  /\ space' = "none"
  /\ UNCHANGED << form >>

MapBadFixed ==
  /\ (form = "bad_fixed" /\ space = "pending")
  /\ space' = "none"
  /\ UNCHANGED << form >>

MapShort ==
  /\ (form = "short" /\ space = "pending")
  /\ space' = "1rtt"
  /\ UNCHANGED << form >>

MapInitial ==
  /\ (form = "initial" /\ space = "pending")
  /\ space' = "initial"
  /\ UNCHANGED << form >>

MapZerortt ==
  /\ (form = "zerortt" /\ space = "pending")
  /\ space' = "0rtt"
  /\ UNCHANGED << form >>

MapHandshake ==
  /\ (form = "handshake" /\ space = "pending")
  /\ space' = "handshake"
  /\ UNCHANGED << form >>

MapRetry ==
  /\ (form = "retry" /\ space = "pending")
  /\ space' = "none"
  /\ UNCHANGED << form >>

Next ==
  \/ MapEmpty
  \/ MapBadFixed
  \/ MapShort
  \/ MapInitial
  \/ MapZerortt
  \/ MapHandshake
  \/ MapRetry

Spec == Init /\ [][Next]_vars

\* a short header is the 1-RTT space and nothing else is
ShortHeaderIsOneRtt ==
  (form = "short" /\ space # "pending" => space = "1rtt") /\ (space = "1rtt" => form = "short")

\* Initial, 0-RTT, and Handshake map to those spaces
LongTypesMatchTheirSpace ==
  (form = "initial" /\ space # "pending" => space = "initial") /\ (form = "zerortt" /\ space # "pending" => space = "0rtt") /\ (form = "handshake" /\ space # "pending" => space = "handshake")

\* Retry is not decrypted as a packet-number space
RetryIsNotASpace ==
  form = "retry" /\ space # "pending" => space = "none"

\* a clear fixed bit is not a packet space
ClearFixedBitIsNotASpace ==
  form = "bad_fixed" /\ space # "pending" => space = "none"

\* an empty datagram is not a packet space
EmptyIsNotASpace ==
  form = "empty" /\ space # "pending" => space = "none"

\* 0-RTT is classified on its own, not as 1-RTT and not as Initial
ZeroRttIsItsOwnSpace ==
  space = "0rtt" => form = "zerortt"

\* the no-space result is only empty, a clear fixed bit, or Retry
NoneOnlyForRejects ==
  space = "none" => form \in {"empty", "bad_fixed", "retry"}

====
