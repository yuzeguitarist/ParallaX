Spec == Init /\ [][Next]_vars

\* a one-slot carrier never owns two unfinished supervisors
MuxCapacityCountsBothHalves ==
  capacity = 1 => ~(charged0 /\ charged1)

\* a frame, setup failure, or cancellation affects only its own stream
MuxLocalEventsPreserveSibling ==
  event # "teardown" => ((focus = 0 => (task1 = before_task1 /\ upload1 = before_upload1 /\ up1 = before_up1 /\ down1 = before_down1 /\ charged1 = before_charged1)) /\ (focus = 1 => (task0 = before_task0 /\ upload0 = before_upload0 /\ up0 = before_up0 /\ down0 = before_down0 /\ charged0 = before_charged0)))

\* duplicate/capacity Open rejection and Cover change neither stream
MuxRejectedOpenAndCoverAreInert ==
  event \in {"DuplicateOpen", "CapacityReject", "Cover"} => (task0 = before_task0 /\ upload0 = before_upload0 /\ up0 = before_up0 /\ down0 = before_down0 /\ charged0 = before_charged0 /\ task1 = before_task1 /\ upload1 = before_upload1 /\ up1 = before_up1 /\ down1 = before_down1 /\ charged1 = before_charged1)

\* carrier teardown leaves no owned supervisor or target half
MuxTeardownReleasesAllSlots ==
  phase = "closed" => (~charged0 /\ ~charged1 /\ ~up0 /\ ~up1 /\ ~down0 /\ ~down1)

\* a live task and its slot remain paired until task exit
MuxOwnership0 ==
  (charged0 => task0 # "none") /\ (task0 # "none" => charged0) /\ (upload0 => charged0)

\* one remaining relay direction still consumes capacity
MuxLiveHalfKeepsSlot0 ==
  (up0 \/ down0) => charged0

\* FIN removes upload routing while preserving the supervisor and both target halves
MuxFinIsHalfClose0 ==
  event = "Fin" /\ focus = 0 => (~upload0 /\ charged0 /\ task0 = before_task0 /\ up0 = before_up0 /\ down0 = before_down0)

\* no new DATA is enqueued after upload routing is removed
MuxDataRequiresUploadRoute0 ==
  event = "DataDelivered" /\ focus = 0 => (upload0 /\ up0 /\ charged0)

\* requesting cancellation does not prematurely release its slot
MuxResetKeepsSlotUntilExit0 ==
  event = "Reset" /\ focus = 0 => (task0 = "cancelling" /\ charged0 /\ ~upload0)

\* a live task and its slot remain paired until task exit
MuxOwnership1 ==
  (charged1 => task1 # "none") /\ (task1 # "none" => charged1) /\ (upload1 => charged1)

\* one remaining relay direction still consumes capacity
MuxLiveHalfKeepsSlot1 ==
  (up1 \/ down1) => charged1

\* FIN removes upload routing while preserving the supervisor and both target halves
MuxFinIsHalfClose1 ==
  event = "Fin" /\ focus = 1 => (~upload1 /\ charged1 /\ task1 = before_task1 /\ up1 = before_up1 /\ down1 = before_down1)

\* no new DATA is enqueued after upload routing is removed
MuxDataRequiresUploadRoute1 ==
  event = "DataDelivered" /\ focus = 1 => (upload1 /\ up1 /\ charged1)

\* requesting cancellation does not prematurely release its slot
MuxResetKeepsSlotUntilExit1 ==
  event = "Reset" /\ focus = 1 => (task1 = "cancelling" /\ charged1 /\ ~upload1)

====
