\* Generated by formal/plx_formal.py from the ParallaXBbr tables.
\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* BBR Startup, ProbeBW, and ProbeRTT. Loss does not change the mode.
\*
\* Safety claims (states and steps that must be unreachable):
\*   StartupIsUnfilled: Startup means the pipe is not full, the quiet count is below 3, and the gain phase is unused
\*   ProbeBwMeansFull: ProbeBW is only entered once the pipe has filled, on the third quiet round
\*   ProbeRttMeansFull: ProbeRTT is only entered from a full pipe, and not on the ack that filled it
\*   ZeroSampleDoesNotCount: a zero bandwidth sample resets the quiet count and does not fill the pipe
\*   PhaseInCycle: the ProbeBW gain index stays inside the 8-phase cycle
\*   QuietInBounds: the Startup quiet count stays in 0..3

---- MODULE ParallaXBbr ----
EXTENDS Integers

VARIABLES mode, filled, quiet, phase, loss, undid, probe_due

vars == << mode, filled, quiet, phase, loss, undid, probe_due >>

Init ==
  /\ mode = "startup"
  /\ filled = FALSE
  /\ quiet = 0
  /\ phase = 0
  /\ loss = FALSE
  /\ undid = FALSE
  /\ probe_due = FALSE

NoGrow ==
  /\ (mode = "startup" /\ ~filled /\ quiet < 2)
  /\ quiet' = quiet + 1
  /\ undid' = FALSE
  /\ UNCHANGED << mode, filled, phase, loss, probe_due >>

SampleZero ==
  /\ (mode = "startup" /\ ~filled /\ (quiet # 0 \/ ~undid))
  /\ quiet' = 0
  /\ undid' = TRUE
  /\ UNCHANGED << mode, filled, phase, loss, probe_due >>

Grow ==
  /\ (mode = "startup" /\ ~filled /\ quiet # 0)
  /\ quiet' = 0
  /\ undid' = FALSE
  /\ UNCHANGED << mode, filled, phase, loss, probe_due >>

Fill ==
  /\ (mode = "startup" /\ ~filled /\ quiet = 2)
  /\ mode' = "probe_bw"
  /\ filled' = TRUE
  /\ quiet' = 3
  /\ phase' = 2
  /\ undid' = FALSE
  /\ probe_due' = FALSE
  /\ UNCHANGED << loss >>

Advance ==
  /\ (mode = "probe_bw" /\ phase < 7)
  /\ phase' = phase + 1
  /\ UNCHANGED << mode, filled, quiet, loss, undid, probe_due >>

AdvanceWrap ==
  /\ (mode = "probe_bw" /\ phase = 7)
  /\ phase' = 0
  /\ UNCHANGED << mode, filled, quiet, loss, undid, probe_due >>

ArmProbeRtt ==
  /\ (mode = "probe_bw" /\ filled /\ ~probe_due)
  /\ probe_due' = TRUE
  /\ UNCHANGED << mode, filled, quiet, phase, loss, undid >>

EnterProbeRtt ==
  /\ (mode = "probe_bw" /\ filled /\ probe_due)
  /\ mode' = "probe_rtt"
  /\ UNCHANGED << filled, quiet, phase, loss, undid, probe_due >>

ExitProbeRtt ==
  /\ (mode = "probe_rtt" /\ filled)
  /\ mode' = "probe_bw"
  /\ phase' = 2
  /\ probe_due' = FALSE
  /\ UNCHANGED << filled, quiet, loss, undid >>

Loss ==
  /\ (~loss)
  /\ loss' = TRUE
  /\ UNCHANGED << mode, filled, quiet, phase, undid, probe_due >>

Next ==
  \/ NoGrow
  \/ SampleZero
  \/ Grow
  \/ Fill
  \/ Advance
  \/ AdvanceWrap
  \/ ArmProbeRtt
  \/ EnterProbeRtt
  \/ ExitProbeRtt
  \/ Loss

Spec == Init /\ [][Next]_vars

\* Startup means the pipe is not full, the quiet count is below 3, and the gain phase is unused
StartupIsUnfilled ==
  mode = "startup" => (~filled /\ quiet < 3 /\ phase = 0)

\* ProbeBW is only entered once the pipe has filled, on the third quiet round
ProbeBwMeansFull ==
  mode = "probe_bw" => (filled /\ quiet = 3)

\* ProbeRTT is only entered from a full pipe, and not on the ack that filled it
ProbeRttMeansFull ==
  mode = "probe_rtt" => (filled /\ quiet = 3 /\ probe_due)

\* a zero bandwidth sample resets the quiet count and does not fill the pipe
ZeroSampleDoesNotCount ==
  undid => (quiet = 0 /\ mode = "startup" /\ ~filled)

\* the ProbeBW gain index stays inside the 8-phase cycle
PhaseInCycle ==
  phase \in {0, 1, 2, 3, 4, 5, 6, 7}

\* the Startup quiet count stays in 0..3
QuietInBounds ==
  quiet \in {0, 1, 2, 3}

====
