  \/ (prot = "on" /\ slot_n = "none" /\ slot_t = "none" /\ scene = "none" /\ last = "none" /\ cand_n = "none" /\ stored = FALSE /\ kind = "none" /\ pruned = FALSE /\ n = 0)

OffInsert ==
  /\ (prot = "off" /\ n < 2)
  /\ last' = "inserted"
  /\ cand_n' = "a"
  /\ stored' = FALSE
  /\ kind' = "off"
  /\ n' = n + 1
  /\ UNCHANGED << prot, slot_n, slot_t, scene, pruned >>

