\* Generated by formal/plx_formal.py from the ParallaXClose tables.
\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* QUIC local, peer, and idle close: at most one close packet, then drain.
\*
\* Safety claims (states and steps that must be unreachable):
\*   OpenHasNoClose: an open connection has no close reason and has not sent a close packet
\*   ClosePacketOnlyForLocal: the single close packet is sent only for a local close
\*   PeerCloseIsSilent: a peer CONNECTION_CLOSE does not send one back
\*   IdleCloseIsSilent: an idle timeout does not send a CONNECTION_CLOSE
\*   TransmitAfterCloseIsTheClosePacket: after close the only transmit is the local close packet; app, stream, ACK, and probe sends stay in the open phase
\*   DrainedHasAReason: a drained connection was closed locally, by the peer, or by idle timeout

---- MODULE ParallaXClose ----
EXTENDS Integers

VARIABLES phase, reason, sent, app, after

vars == << phase, reason, sent, app, after >>

Init ==
  /\ phase = "open"
  /\ reason = "none"
  /\ sent = FALSE
  /\ app = FALSE
  /\ after = "none"

SendApp ==
  /\ (phase = "open" /\ ~app)
  /\ app' = TRUE
  /\ after' = "appdata"
  /\ UNCHANGED << phase, reason, sent >>

SendAck ==
  /\ (phase = "open" /\ after = "none")
  /\ after' = "ack"
  /\ UNCHANGED << phase, reason, sent, app >>

SendStream ==
  /\ (phase = "open" /\ after = "none")
  /\ after' = "stream"
  /\ UNCHANGED << phase, reason, sent, app >>

SendProbe ==
  /\ (phase = "open" /\ after = "none")
  /\ after' = "probe"
  /\ UNCHANGED << phase, reason, sent, app >>

LocalClose ==
  /\ (phase = "open")
  /\ phase' = "closing"
  /\ reason' = "local"
  /\ after' = "none"
  /\ UNCHANGED << sent, app >>

PeerClose ==
  /\ (phase = "open")
  /\ phase' = "closing"
  /\ reason' = "peer"
  /\ after' = "none"
  /\ UNCHANGED << sent, app >>

IdleClose ==
  /\ (phase = "open")
  /\ phase' = "closing"
  /\ reason' = "idle"
  /\ after' = "none"
  /\ UNCHANGED << sent, app >>

SendClose ==
  /\ ((phase = "closing" \/ phase = "drained") /\ reason = "local" /\ ~sent)
  /\ sent' = TRUE
  /\ after' = "close"
  /\ UNCHANGED << phase, reason, app >>

DrainAfterClose ==
  /\ (phase = "closing" /\ reason = "local" /\ sent)
  /\ phase' = "drained"
  /\ UNCHANGED << reason, sent, app, after >>

DrainBeforeClose ==
  /\ (phase = "closing" /\ reason = "local" /\ ~sent)
  /\ phase' = "drained"
  /\ UNCHANGED << reason, sent, app, after >>

DrainPeer ==
  /\ (phase = "closing" /\ reason = "peer")
  /\ phase' = "drained"
  /\ UNCHANGED << reason, sent, app, after >>

DrainIdle ==
  /\ (phase = "closing" /\ reason = "idle")
  /\ phase' = "drained"
  /\ UNCHANGED << reason, sent, app, after >>

Next ==
  \/ SendApp
  \/ SendAck
  \/ SendStream
  \/ SendProbe
  \/ LocalClose
  \/ PeerClose
  \/ IdleClose
  \/ SendClose
  \/ DrainAfterClose
  \/ DrainBeforeClose
  \/ DrainPeer
  \/ DrainIdle

Spec == Init /\ [][Next]_vars

\* an open connection has no close reason and has not sent a close packet
OpenHasNoClose ==
  phase = "open" => (reason = "none" /\ ~sent /\ after # "close")

\* the single close packet is sent only for a local close
ClosePacketOnlyForLocal ==
  sent => (reason = "local" /\ after = "close")

\* a peer CONNECTION_CLOSE does not send one back
PeerCloseIsSilent ==
  reason = "peer" => (~sent /\ after = "none")

\* an idle timeout does not send a CONNECTION_CLOSE
IdleCloseIsSilent ==
  reason = "idle" => (~sent /\ after = "none")

\* after close the only transmit is the local close packet; app, stream, ACK, and probe sends stay in the open phase
TransmitAfterCloseIsTheClosePacket ==
  (phase \in {"closing", "drained"} => after \in {"none", "close"}) /\ (after \in {"appdata", "ack", "stream", "probe"} => phase = "open")

\* a drained connection was closed locally, by the peer, or by idle timeout
DrainedHasAReason ==
  phase = "drained" => reason \in {"local", "peer", "idle"}

====
