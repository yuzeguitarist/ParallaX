\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* Inbound auth, then SNI presence, then SNI authorization.
\*
\* Safety claims (states and steps that must be unreachable):
\*   MissingSniOnlyAfterAuth: missing SNI is reported only after the record authenticated and carried its material
\*   UnauthorizedOnlyAfterSni: an unauthorized name is reported only when auth succeeded and a name was present
\*   AuthenticatedClearsEveryGate: the authenticated branch has a good record, material, and an authorized SNI
\*   AuthFailIsNotASniDecision: an auth failure is a bad record or missing material, not a SNI decision

---- MODULE ParallaXInbound ----
EXTENDS Integers

VARIABLES record_ok, material, has_sni, sni_ok, gate

vars == << record_ok, material, has_sni, sni_ok, gate >>

Init ==
  \/ (record_ok = FALSE /\ material = FALSE /\ has_sni = FALSE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = FALSE /\ has_sni = FALSE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = FALSE /\ has_sni = TRUE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = FALSE /\ has_sni = TRUE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = TRUE /\ has_sni = FALSE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = TRUE /\ has_sni = FALSE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = TRUE /\ has_sni = TRUE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = FALSE /\ material = TRUE /\ has_sni = TRUE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = FALSE /\ has_sni = FALSE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = FALSE /\ has_sni = FALSE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = FALSE /\ has_sni = TRUE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = FALSE /\ has_sni = TRUE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = TRUE /\ has_sni = FALSE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = TRUE /\ has_sni = FALSE /\ sni_ok = TRUE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = TRUE /\ has_sni = TRUE /\ sni_ok = FALSE /\ gate = "start")
  \/ (record_ok = TRUE /\ material = TRUE /\ has_sni = TRUE /\ sni_ok = TRUE /\ gate = "start")

FailClosed ==
  /\ (gate = "start" /\ ~record_ok)
  /\ gate' = "auth_fail"
  /\ UNCHANGED << record_ok, material, has_sni, sni_ok >>

FailMaterial ==
  /\ (gate = "start" /\ record_ok /\ ~material)
  /\ gate' = "auth_fail"
  /\ UNCHANGED << record_ok, material, has_sni, sni_ok >>

FailMissingSni ==
  /\ (gate = "start" /\ record_ok /\ material /\ ~has_sni)
  /\ gate' = "missing"
  /\ UNCHANGED << record_ok, material, has_sni, sni_ok >>

FailUnauthorized ==
  /\ (gate = "start" /\ record_ok /\ material /\ has_sni /\ ~sni_ok)
  /\ gate' = "unauth"
  /\ UNCHANGED << record_ok, material, has_sni, sni_ok >>

Accept ==
  /\ (gate = "start" /\ record_ok /\ material /\ has_sni /\ sni_ok)
  /\ gate' = "ok"
  /\ UNCHANGED << record_ok, material, has_sni, sni_ok >>

Next ==
  \/ FailClosed
  \/ FailMaterial
  \/ FailMissingSni
  \/ FailUnauthorized
  \/ Accept

Spec == Init /\ [][Next]_vars

\* missing SNI is reported only after the record authenticated and carried its material
MissingSniOnlyAfterAuth ==
  gate = "missing" => (record_ok /\ material /\ ~has_sni)

\* an unauthorized name is reported only when auth succeeded and a name was present
UnauthorizedOnlyAfterSni ==
  gate = "unauth" => (record_ok /\ material /\ has_sni /\ ~sni_ok)

\* the authenticated branch has a good record, material, and an authorized SNI
AuthenticatedClearsEveryGate ==
  gate = "ok" => (record_ok /\ material /\ has_sni /\ sni_ok)

\* an auth failure is a bad record or missing material, not a SNI decision
AuthFailIsNotASniDecision ==
  gate = "auth_fail" => (~record_ok \/ ~material)

