Spec == Init /\ [][Next]_vars

\* a partial payload cannot exceed its latched total
FragmentsStayWithinTotal ==
  (total = 0 => cursor = 0) /\ (total # 0 => (cursor < total /\ total \in {1, 2, 3}))

\* only an exactly complete frame can be returned
EmitOnlyCompleteFrame ==
  emitted => (outcome = "complete" /\ last_size = last_total /\ last_total # 0 /\ frames # 0)

\* a returned frame clears the latch and buffer before reuse
CompletionClearsLatch ==
  outcome = "complete" => (total = 0 /\ cursor = 0)

\* a malformed or inconsistent chunk emits no frame
RejectedChunkEmitsNothing ==
  outcome = "error" => (stopped /\ ~emitted)

\* a partial chunk remains buffered
PartialChunkEmitsNothing ==
  outcome = "partial" => (~emitted /\ total # 0 /\ cursor # 0)

\* two frames suffice to exercise completion and reuse
FrameCountIsBounded ==
  frames \in {0, 1, 2}

