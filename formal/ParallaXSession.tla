\* Generated by formal/plx_formal.py from the ParallaXSession tables.
\* Do not edit by hand. Run: python3 formal/plx_formal.py emit
\*
\* Handshake, PQ rekey, replay commit, identity, app data, UDP retain, failure, and reconnect.
\*
\* Safety claims (states and steps that must be unreachable):
\*   AppOnlyAfterIdentity: application data only after identity, at epoch 1, with live keys
\*   VerifiedImpliesBinding: verified and app phases have a binding, epoch 1, and live keys
\*   RekeyedImpliesFreshCommit: a rekeyed session has a fresh replay insert, a binding, and epoch 1
\*   ReplayClosesBeforeRekey: replay, stale, and cache-full close before rekey: epoch stays 0
\*   IdleAndReconnectAreFresh: idle, including after reconnect, holds no keys, binding, app data, or failure class
\*   AuthedHasNoKeys: authentication alone has not installed epoch-0 keys
\*   PostAuthDegenerateDoesNotSplice: an all-zero shared secret after auth closes with no keys and is not a fallback splice
\*   RekeyDegenerateStaysAtEpochZero: an all-zero ephemeral in hybrid_sandwich_rekey fails the rekey without splicing or advancing the epoch
\*   SpliceIsTheInboundReject: a fallback splice is an inbound auth or SNI reject before keys exist
\*   TerminalDropsUsableKeys: rejected, closed, and failed sessions cannot seal or send app data
\*   UdpRetainOnlyAfterApp: a retained QUIC leg exists only on a live, identity-verified app session
\*   UdpDeclineStaysOnApp: a declined or failed UDP probe leaves the app session on TCP
\*   UsableKeysImplyAuth: usable keys exist only after auth, and never in the idle phase
\*   EpochIsZeroOrOne: a successful rekey steps the epoch by one and never past 1 here
\*   RejectedOnlyAfterReplay: the rejected phase is produced only by a replay-cache refusal
\*   BindingMeansRekeyedEpoch: an identity binding exists only at epoch 1 after a fresh replay insert
\*   AttemptInBounds: reconnect is bounded; attempt 2 is the last one

---- MODULE ParallaXSession ----
EXTENDS Integers

VARIABLES phase, epoch, binding, keys, usable, replay, attempt, app, udp, how

vars == << phase, epoch, binding, keys, usable, replay, attempt, app, udp, how >>

Init ==
  /\ phase = "idle"
  /\ epoch = 0
  /\ binding = FALSE
  /\ keys = FALSE
  /\ usable = FALSE
  /\ replay = "none"
  /\ attempt = 0
  /\ app = FALSE
  /\ udp = "none"
  /\ how = "none"

AuthFail ==
  /\ (phase = "idle")
  /\ phase' = "failed"
  /\ how' = "splice"
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, app, udp >>

MissingSni ==
  /\ (phase = "idle")
  /\ phase' = "failed"
  /\ how' = "splice"
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, app, udp >>

UnauthorizedSni ==
  /\ (phase = "idle")
  /\ phase' = "failed"
  /\ how' = "splice"
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, app, udp >>

AuthOk ==
  /\ (phase = "idle")
  /\ phase' = "authed"
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, app, udp, how >>

DegenerateSharedSecret ==
  /\ (phase = "authed")
  /\ phase' = "failed"
  /\ how' = "degen"
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, app, udp >>

InstallEpoch0 ==
  /\ (phase = "authed")
  /\ phase' = "epoch0"
  /\ keys' = TRUE
  /\ usable' = TRUE
  /\ UNCHANGED << epoch, binding, replay, attempt, app, udp, how >>

SendRekey ==
  /\ (phase = "epoch0" /\ usable /\ ~binding)
  /\ phase' = "rekey_wait"
  /\ replay' = "pending"
  /\ UNCHANGED << epoch, binding, keys, usable, attempt, app, udp, how >>

ReplayReplayed ==
  /\ (phase = "rekey_wait" /\ replay = "pending")
  /\ phase' = "rejected"
  /\ usable' = FALSE
  /\ replay' = "replayed"
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, attempt, how >>

ReplayStale ==
  /\ (phase = "rekey_wait" /\ replay = "pending")
  /\ phase' = "rejected"
  /\ usable' = FALSE
  /\ replay' = "stale"
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, attempt, how >>

ReplayCacheFull ==
  /\ (phase = "rekey_wait" /\ replay = "pending")
  /\ phase' = "rejected"
  /\ usable' = FALSE
  /\ replay' = "full"
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, attempt, how >>

RekeyMalformed ==
  /\ (phase = "rekey_wait")
  /\ phase' = "failed"
  /\ usable' = FALSE
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, replay, attempt, how >>

RekeyDegenerate ==
  /\ (phase = "rekey_wait")
  /\ phase' = "failed"
  /\ usable' = FALSE
  /\ app' = FALSE
  /\ udp' = "none"
  /\ how' = "rekey_degen"
  /\ UNCHANGED << epoch, binding, keys, replay, attempt >>

VerifyBeforeBinding ==
  /\ (phase \in {"epoch0", "rekey_wait"})
  /\ phase' = "failed"
  /\ usable' = FALSE
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, replay, attempt, how >>

RekeyOk ==
  /\ (phase = "rekey_wait" /\ replay = "pending" /\ usable)
  /\ phase' = "rekeyed"
  /\ epoch' = epoch + 1
  /\ binding' = TRUE
  /\ replay' = "inserted"
  /\ UNCHANGED << keys, usable, attempt, app, udp, how >>

IdentityOk ==
  /\ (phase = "rekeyed" /\ binding /\ epoch = 1)
  /\ phase' = "verified"
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, app, udp, how >>

IdentityFail ==
  /\ (phase = "rekeyed")
  /\ phase' = "failed"
  /\ usable' = FALSE
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, replay, attempt, how >>

EnterApp ==
  /\ (phase = "verified" /\ binding /\ epoch = 1 /\ usable)
  /\ phase' = "app"
  /\ app' = TRUE
  /\ UNCHANGED << epoch, binding, keys, usable, replay, attempt, udp, how >>

ProbeRetain ==
  /\ (phase = "app" /\ udp = "none")
  /\ udp' = "retained"
  /\ UNCHANGED << phase, epoch, binding, keys, usable, replay, attempt, app, how >>

ProbeStayTcp ==
  /\ (phase = "app" /\ udp = "none")
  /\ udp' = "tcp_only"
  /\ UNCHANGED << phase, epoch, binding, keys, usable, replay, attempt, app, how >>

Close ==
  /\ (phase \in {"epoch0", "rekey_wait", "rekeyed", "verified", "app"})
  /\ phase' = "closed"
  /\ usable' = FALSE
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, replay, attempt, how >>

TransportError ==
  /\ (phase \in {"epoch0", "rekey_wait", "rekeyed", "verified", "app"})
  /\ phase' = "failed"
  /\ usable' = FALSE
  /\ app' = FALSE
  /\ udp' = "none"
  /\ UNCHANGED << epoch, binding, keys, replay, attempt, how >>

Reconnect ==
  /\ (phase \in {"rejected", "closed", "failed"} /\ attempt < 2)
  /\ phase' = "idle"
  /\ epoch' = 0
  /\ binding' = FALSE
  /\ keys' = FALSE
  /\ usable' = FALSE
  /\ replay' = "none"
  /\ attempt' = attempt + 1
  /\ app' = FALSE
  /\ udp' = "none"
  /\ how' = "none"

